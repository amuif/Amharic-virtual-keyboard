{
  "name": "@amharic-virtual-keyboard/react",
  "version": "1.1.0",
  "private": false,
  "description": "Amharic virtual keyboard React component",
  "license": "MIT",
  "author": "amuif",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/amuif/Amharic-virtual-keyboard.git",
    "directory": "apps/react"
  },
  "homepage": "https://github.com/amuif/Amharic-virtual-keyboard/tree/main/apps/react#readme",
